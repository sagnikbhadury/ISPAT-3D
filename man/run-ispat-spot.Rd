\name{run_ispat_spot}
\alias{run_ispat_spot}
\alias{run_ispat_spot_bigmem}
\title{Run ISPat-3D for a single spot}
\usage{
run_ispat_spot(Y_sp, S_sp, ncores, Kernel = "Matern", MSFA_method = "CAVI")

run_ispat_spot_bigmem(Y_sp, S_sp, ncores, Kernel = "Matern",
                       MSFA_method = "CAVI", bm_dir = tempdir())
}
\arguments{
\item{Y_sp}{G x N marker/gene expression matrix for this spot (G markers, N cells).}

\item{S_sp}{N x 4 matrix of (x, y, z, zone) for this spot; the 4th column is
an integer zone/density annotation.}

\item{ncores}{Number of cores for the parallel per-marker GP fit.}

\item{Kernel}{Spatial covariance kernel: \code{"Matern"} or \code{"RBF"}.}

\item{MSFA_method}{Multi-study factor analysis algorithm: \code{"CAVI"} or \code{"SVI"}.}

\item{bm_dir}{(\code{run_ispat_spot_bigmem} only) Directory to use for the
temporary bigmemory backing file; defaults to \code{tempdir()}. The backing
file is removed when the function finishes.}
}
\value{
A list with elements \code{Shared_Net} (G x G shared network),
\code{Zone_Nets} (named list of G x G zone-specific networks), \code{Z_est}
(de-spatialised residuals per zone), and \code{VBfit} (raw MSFA fit).
}
\description{
\code{run_ispat_spot} fits the 3D spatial GP to every marker within every
zone of a single spot/field of view, then runs a multi-study factor
analysis across zones on the resulting de-spatialised residuals to recover
a shared cell-type interaction network and zone-specific networks.

\code{run_ispat_spot_bigmem} is a memory-efficient drop-in replacement that
avoids serializing the full expression matrix to every parallel worker;
instead it is written once to a memory-mapped \pkg{bigmemory} backing file
that each worker attaches to. Requires the \pkg{bigmemory} package.
}
\seealso{
\code{\link{ISPAT_3D}}, which calls \code{run_ispat_spot} once per spot.
}
