% Generated by hand to match roxygen comments in R/network-utils.R.
% Please edit that file and re-run devtools::document() if regenerating.
\name{cov_to_pcor}
\alias{cov_to_pcor}
\alias{plot_pcor_chord}
\title{Partial correlation utilities for ISPAT3D networks}
\usage{
cov_to_pcor(Sigma, cell_types = rownames(Sigma))

plot_pcor_chord(pcor_mat, title, threshold, node_colors = NULL)
}
\arguments{
\item{Sigma}{A symmetric G x G covariance/network matrix.}

\item{cell_types}{Optional character vector of length G giving row/column
names for the result; if omitted, the row/column names of \code{Sigma} are
used (if present).}

\item{pcor_mat}{A symmetric partial correlation matrix with row/column
names, as returned by \code{cov_to_pcor}.}

\item{title}{Plot title.}

\item{threshold}{Only edges with \code{abs(partial correlation) >= threshold} are drawn.}

\item{node_colors}{Optional named character vector of node fill colors,
keyed by the row/column names of \code{pcor_mat}. If omitted, a default
qualitative palette is used.}
}
\value{
\code{cov_to_pcor} returns a symmetric G x G partial correlation matrix
with unit diagonal.

\code{plot_pcor_chord} returns a \pkg{ggplot2}/\pkg{ggraph} plot object, or
\code{NULL} (invisibly, with a message) if no edges exceed \code{threshold}.
}
\description{
\code{cov_to_pcor} converts a shared or zone-specific network returned by
\code{\link{run_ispat_spot}} / \code{\link{ISPAT_3D}} (e.g.
\code{result$Shared_Net}) into a partial correlation matrix, which is often
easier to interpret and threshold for visualization: entries close to zero
indicate cell types that are conditionally independent given all other cell
types.

\code{plot_pcor_chord} draws a circular ("chord") diagram of a partial
correlation matrix, with nodes arranged on a circle, edges colored by the
sign of the partial correlation (positive = conditionally co-localised,
negative = conditional spatial exclusion), and edge width/opacity
proportional to edge strength. Requires the \pkg{dplyr}, \pkg{igraph},
\pkg{tidygraph}, \pkg{ggraph}, \pkg{ggplot2}, and \pkg{scales} packages.
}
\examples{
\dontrun{
pcor <- cov_to_pcor(result$Shared_Net, cell_types = rownames(Y))
plot_pcor_chord(pcor, title = "Shared network", threshold = 0.05)
}
}
