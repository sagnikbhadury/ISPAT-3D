\name{cavi_msfa}
\alias{cavi_msfa}
\alias{svi_msfa}
\title{Multi-study factor analysis (CAVI and SVI variants)}
\usage{
cavi_msfa(X_s, K, J_s, verbose = 1, min_iter = 5, tol = 5e-3,
          max_iter = 100, scale = TRUE)

svi_msfa(X_s, K, J_s, batch_prop = 0.2, fr = 0.75, delay = 1,
         verbose = 1, tol = 5e-3, min_iter = 5, max_iter = 100, scale = TRUE)
}
\arguments{
\item{X_s}{A list of S numeric matrices (one per study/zone), each N_s x P
(N_s observations, P variables), where P must be the same across all studies.}

\item{K}{Number of shared latent factors.}

\item{J_s}{Vector of length S giving the number of study-specific latent
factors for each study.}

\item{verbose}{Verbosity level: 0 (silent), 1 (progress), 2+ (detailed
per-iteration diagnostics).}

\item{min_iter}{Minimum number of iterations before convergence is checked.}

\item{tol}{Relative convergence tolerance.}

\item{max_iter}{Maximum number of iterations.}

\item{scale}{Logical; if \code{TRUE}, each study's data is centered and
scaled to unit variance before fitting; if \code{FALSE}, only centered.}

\item{batch_prop}{(\code{svi_msfa} only) Proportion of each study's
observations sampled per mini-batch iteration.}

\item{fr}{(\code{svi_msfa} only) Forgetting rate exponent for the
Robbins-Monro step size.}

\item{delay}{(\code{svi_msfa} only) Delay parameter for the Robbins-Monro
step size.}
}
\value{
A list with elements \code{mean_phi} (shared loadings, P x K),
\code{var_phi}, \code{mean_lambda_s} (list of study-specific loadings, each
P x J_s), \code{var_lambda_s}, \code{mean_psi_s} (study-specific residual
variances), \code{shape_psi_s}, \code{rate_psi_s}.
}
\description{
\code{cavi_msfa} fits a multi-study/multi-group factor model to a list of
de-spatialised marker-expression matrices (one matrix per zone/spot),
decomposing each study's covariance into a shared factor structure (common
across all zones) and a zone-specific factor structure, via
coordinate-ascent variational inference with a multiplicative gamma-process
shrinkage prior on the loadings.

\code{svi_msfa} is a stochastic-variational-inference counterpart that
updates parameters from random mini-batches at each iteration using a
Robbins-Monro step size, which can scale better to large numbers of spatial
locations per zone.
}
\seealso{
\code{\link{run_ispat_spot}}, which calls these functions internally on
de-spatialised marker residuals.
}
